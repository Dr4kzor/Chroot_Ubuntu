sudo -a -- "$PREFIX/bin/unshare" --mount --propagation private /system/bin/sh <<'CHECK'
  set -e
  mount --bind /dev /data/local/ubuntu/dev
  mount -t proc proc /data/local/ubuntu/proc

  /data/data/com.termux/files/usr/bin/chroot /data/local/ubuntu \
    /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    /bin/su - user -c '
      id
      cat /proc/self/attr/current
      grep -E "Seccomp|NoNewPrivs" /proc/self/status
      sftp -vvv -oBatchMode=yes android-storage-prim-ftpd
    '
  CHECK
